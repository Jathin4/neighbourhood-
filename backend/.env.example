# Copy to .env and adjust. Defaults already point at <repo>/db/tnn.db.
ENV=dev
# DATABASE_URL=sqlite+aiosqlite:///D:/workspace/TRUSTED NEIGHBOURHOOD NETWORK/db/tnn.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/tnn

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
# Return the OTP in the API response for local testing. Set false outside dev.
OTP_DEBUG=true
