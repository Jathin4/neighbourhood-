# Copy to .env and adjust. Defaults already point at <repo>/db/tnn.db.
ENV=dev
# DATABASE_URL=sqlite+aiosqlite:///D:/workspace/TRUSTED NEIGHBOURHOOD NETWORK/db/tnn.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/tnn

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
# Return the OTP in the API response for local testing. Set false outside dev.
OTP_DEBUG=true
# Fast2SMS "otp" route (no DLT template needed): https://www.fast2sms.com/otp-sms/
# Unset -> OTP is only logged to the console (dev). Set OTP_DEBUG=false once this works
# so the code stops being echoed back in the API response.
# FAST2SMS_API_KEY=
